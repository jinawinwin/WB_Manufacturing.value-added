name: Update World Bank manufacturing data
on:
  schedule:
    - cron: "0 0 10 1,7 *"   # 매년 1월·7월 10일 00:00 UTC (한국시간 09:00)
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install pandas openpyxl pycountry-convert
      - run: python scripts/fetch_wb.py
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --quiet || git commit -m "data: auto-update $(date -u +%F)"
          git push
